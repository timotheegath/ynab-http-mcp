# DEV environment — safe to experiment, uses dev/sandbox YNAB credentials
# Copy to .env to activate: cp .env.dev.example .env

ENVIRONMENT=dev
YNAB_API_KEY="your_dev_api_key_here"
YNAB_PLAN_ID=6eb84411-a778-43db-ac70-54099d711d5c
LOG_LEVEL=debug
DEBUG_MODE=True
HTTP_PORT=3000
# Show the verbose /full drill-in resources in the MCP catalog (true = show, false = hide).
SHOW_FULL_RESOURCES=false
