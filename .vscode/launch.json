{
    "version": "0.2.0",
    "compounds": [
    ],
    "configurations": [
        {
            "name": "Dev: Attach + MCP Inspector",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": true,
            "preLaunchTask": "run: mcp-inspector"
        }
    ]
}