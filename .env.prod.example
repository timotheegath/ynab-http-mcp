# PROD environment — real YNAB data, handle with care
# Copy to .env to activate: cp .env.prod.example .env
# Never run this from an active coding-agent session.

ENVIRONMENT=prod
YNAB_API_KEY="your_prod_api_key_here"
YNAB_PLAN_ID=cf0ca912-48ed-4485-a384-ed04418903d1
LOG_LEVEL=info
DEBUG_MODE=False
HTTP_PORT=3000
# Show the verbose /full drill-in resources in the MCP catalog (true = show, false = hide).
SHOW_FULL_RESOURCES=false
